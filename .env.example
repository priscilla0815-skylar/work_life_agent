# Model
MODEL_AGENT_NAME=
MODEL_AGENT_PROVIDER=
MODEL_AGENT_API_BASE=
MODEL_AGENT_API_KEY=

# Volcengine credentials
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# OIDC authentication
OIDC_USER_POOL_ID=
OIDC_REGION=cn-beijing
# Optional override for a non-standard issuer URL.
# OIDC_ISSUER=
OIDC_AUDIENCE=
# OIDC_JWKS_URL=
CORS_ORIGINS=https://your-frontend.example.com

# Cloud phone
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
MUA_PRODUCT_ID=
# Volcengine account ID that owns the cloud-phone business.
MUA_ACCOUNT_ID=
# Optional overrides; auto-detected from purchased resources when empty.
# MUA_CONFIGURATION_CODE=
# MUA_CREATE_DC=
MUA_DATA_SIZE=4Gi

# Stream token
MUA_STREAM_TOKEN_MODE=legacy_sts
MUA_STREAM_TOKEN_TTL_SECONDS=600
# MUA_STS_ROLE_TRN=

# Optional local storage paths
# WORK_LIFE_STORE=./data/work_log.json
# USER_POD_BINDINGS_PATH=./config/user_pod_bindings.json
# MUA_POD_POOL_PATH=./config/pod_pool.json
# MUA_RUN_OWNERS_PATH=./config/mua_run_owners.json
